<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.ReadingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:minHeight="600dp">

        <!-- Document Title Display. marginTop is overwritten at runtime in
             ReadingFragment.setupUI to (status-bar inset + reading_title_margin_top) so the
             ScrollView itself can extend edge-to-edge under the status bar. The dimens
             value here is the design-time baseline / preview value. -->
        <TextView
            android:id="@+id/documentTitleDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/reading_title_margin_top"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/no_document_loaded"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Page View Only placeholder — shown when Page View Only mode is active,
             replacing all RSVP controls with a simple message. -->
        <LinearLayout
            android:id="@+id/pageViewOnlyPlaceholder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/documentTitleDisplay"
            app:layout_constraintBottom_toTopOf="@id/fabImportText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/pageViewOnlyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_view_only_active_title"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/pageViewOnlyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_view_only_active_message"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:paddingHorizontal="32dp" />

        </LinearLayout>

        <!-- RSVP Display Area -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rsvpDisplayCard"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/documentTitleDisplay"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            app:contentPadding="0dp"
            app:contentPaddingTop="0dp"
            app:contentPaddingBottom="0dp"
            app:contentPaddingLeft="0dp"
            app:contentPaddingRight="0dp">

            <TextView
                android:id="@+id/rsvpWordDisplay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurface"
                android:padding="0dp"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="Sample" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Import Status Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/importStatusCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rsvpDisplayCard"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/importStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/importing_document"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/importProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toStartOf="@id/pageCounter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/importStatusCard" />

        <!-- Page Counter -->
        <TextView
            android:id="@+id/pageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:text="@string/page_counter_empty"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:minWidth="48dp"
            android:gravity="center"
            android:contentDescription="@string/page_counter_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/progressBar"
            app:layout_constraintBottom_toBottomOf="@id/progressBar" />

        <!-- Word Navigation and Scrubbing Slider -->
        <LinearLayout
            android:id="@+id/navigationLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBar">

            <!-- Previous Word Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousWord"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/previous_word"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOnSurface"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_navigate_before"
                app:iconSize="20dp"
                app:iconPadding="0dp" />

            <!-- Scrubbing Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/positionSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="1"
                android:valueTo="2"
                android:value="1"
                android:stepSize="1"
                android:contentDescription="@string/position_scrubber"
                app:thumbColor="?attr/colorPrimary"
                app:trackColorActive="?attr/colorPrimary"
                app:trackColorInactive="?attr/colorOutline" />

            <!-- Next Word Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextWord"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/next_word"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOnSurface"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_navigate_next"
                app:iconSize="20dp"
                app:iconPadding="0dp" />

        </LinearLayout>

        <!-- Control Buttons - Responsive Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controlsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/navigationLayout">

            <!-- First Row: Navigation and Document Controls -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestartParagraph"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/restart_paragraph"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOnSurface"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_restart_paragraph"
                app:layout_constraintEnd_toStartOf="@id/btnSaveDocument"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDocument"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/save_document"
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorOnSurface"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_save"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnRestartParagraph"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Second Row: Bookmarks -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookmarks"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bookmarks"
                app:icon="@drawable/ic_bookmark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnSaveDocument" />

        </androidx.constraintlayout.widget.ConstraintLayout>



        <!-- WPM Slider -->
        <LinearLayout
            android:id="@+id/wpmSliderLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controlsLayout">

            <TextView
                android:id="@+id/readingWpmValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minWidth="72dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textColor="?attr/colorOnSurface"
                tools:text="250 WPM" />

            <com.google.android.material.slider.Slider
                android:id="@+id/readingWpmSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="100"
                android:valueTo="1000"
                android:value="250"
                android:stepSize="10"
                android:contentDescription="@string/reading_wpm_slider_cd"
                app:thumbColor="?attr/colorPrimary"
                app:trackColorActive="?attr/colorPrimary"
                app:trackColorInactive="?attr/colorOutline" />

        </LinearLayout>

        <!-- Big Hold-to-Play / Tap-to-Toggle Button. Tap (press <
             Constants.HOLD_TO_PLAY_TAP_THRESHOLD_MS) toggles play/pause; press-and-hold
             plays while held and pauses on release. Size driven by @dimen/hold_to_play_button_size
             so the value is parameterised in res/values/dimens.xml. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabHoldToPlay"
            android:layout_width="@dimen/hold_to_play_button_size"
            android:layout_height="@dimen/hold_to_play_button_size"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            app:backgroundTint="?attr/colorSurface"
            app:tint="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOnSurface"
            app:strokeWidth="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wpmSliderLayout"
            app:layout_constraintBottom_toTopOf="@id/fabImportText"
            app:fabSize="auto"
            app:srcCompat="@drawable/ic_play_arrow"
            app:elevation="8dp"
            app:borderWidth="0dp"
            android:contentDescription="@string/hold_to_play"
            android:scaleType="center" />

        <!-- Enter-landscape affordance. Tap forces requestedOrientation=LANDSCAPE; system back
             reverts to UNSPECIFIED. Anchored to the right side of fabHoldToPlay and vertically
             centered on it, so it reads as a "satellite" action next to the primary FAB. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEnterLandscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:fabSize="mini"
            app:backgroundTint="?attr/colorSurface"
            app:tint="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOnSurface"
            app:strokeWidth="1dp"
            app:elevation="4dp"
            app:borderWidth="0dp"
            app:srcCompat="@drawable/ic_fullscreen"
            android:contentDescription="@string/enter_landscape"
            app:layout_constraintStart_toEndOf="@id/fabHoldToPlay"
            app:layout_constraintTop_toTopOf="@id/fabHoldToPlay"
            app:layout_constraintBottom_toBottomOf="@id/fabHoldToPlay" />

        <!-- TTS speech-rate inline selector. Visible only while PlaybackMode == TTS (gated
             from ReadingFragment.observeViewModel). Minus / current-rate / plus row sits
             directly under the big play button. Tapping ± adjusts TtsSettings.speechRate by
             Constants.TTS_RATE_STEP and clamps to [TTS_MIN_RATE, TTS_MAX_RATE]; the buttons
             auto-disable at the limits. The whole row is portrait-only — landscape is the
             immersive reader and intentionally has no chrome below the central card; the
             binding access in ReadingFragment uses safe calls (mirrors fabListenToggle). -->
        <LinearLayout
            android:id="@+id/ttsRateSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/fabHoldToPlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTtsRateDecrease"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:text="@string/tts_rate_decrease_label"
                android:textSize="20sp"
                android:contentDescription="@string/tts_rate_decrease_cd"
                app:cornerRadius="24dp" />

            <TextView
                android:id="@+id/ttsRateValue"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textColor="?attr/colorOnSurface"
                tools:text="1.20x" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTtsRateIncrease"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:text="@string/tts_rate_increase_label"
                android:textSize="20sp"
                android:contentDescription="@string/tts_rate_increase_cd"
                app:cornerRadius="24dp" />

        </LinearLayout>

        <!-- Listen (TTS) toggle satellite. Mirrors fabEnterLandscape on the opposite side of
             fabHoldToPlay. Tap enters TTS mode (read-aloud); tap again returns to RSVP. The
             icon stays ic_volume_up — visual state is communicated by alpha + contentDescription
             updated from ReadingFragment based on activeMode. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabListenToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fabSize="mini"
            app:backgroundTint="?attr/colorSurface"
            app:tint="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOnSurface"
            app:strokeWidth="1dp"
            app:elevation="4dp"
            app:borderWidth="0dp"
            app:srcCompat="@drawable/ic_volume_up"
            android:contentDescription="@string/listen_toggle_cd_start"
            app:layout_constraintEnd_toStartOf="@id/fabHoldToPlay"
            app:layout_constraintTop_toTopOf="@id/fabHoldToPlay"
            app:layout_constraintBottom_toBottomOf="@id/fabHoldToPlay" />

        <!-- Page View FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_description"
            android:contentDescription="@string/switch_to_page_view" />

        <!-- Text Input FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabImportText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_add"
            android:contentDescription="@string/import_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.OptionsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Options Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/options_title"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:layout_marginBottom="16dp" />

        <!-- User Manual: opens a scrollable dialog containing a compendium of every
             feature, gesture, and setting. Lives at the very top of the Settings tab so
             new users can find it before scrolling through the controls. Outlined style
             matches the codebase convention for top-of-section action buttons (corner
             picker / scroll-mode toggle further down) without competing visually with
             the configurable controls below it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/userManualButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/user_manual_button_label" />

        <!-- Page View Only Mode -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/pageViewOnlyToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/page_view_only_mode_label"
                    android:checked="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_view_only_mode_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Reading Speed Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reading_speed_settings"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/base_wpm_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/baseWpmValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="250 WPM"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/baseWpmSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="100"
                    android:valueTo="1000"
                    android:value="250"
                    android:stepSize="10" />

                <!-- Chunk Size Setting -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chunk_size_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/chunkSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 word"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/chunkSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="5"
                    android:value="1"
                    android:stepSize="1" />

                <!-- Font Size Setting -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/font_size_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/fontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32sp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/fontSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="16"
                    android:valueTo="72"
                    android:value="32"
                    android:stepSize="2" />

                <!-- ORP Highlighting Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/orpToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/orp_highlighting_label"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/orp_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

                <!-- Center ORP Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/centerOrpToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/center_orp_label"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/center_orp_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

                <!-- ORP Color Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/orpColorDropdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/orpColorDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/orp_color_label"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Screen Dimming Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/screenDimmingToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/screen_dimming_label"
                    android:checked="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_dimming_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />



                <!-- Landscape Play Button Corner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/landscape_play_button_corner_label"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/landscape_play_button_corner_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/landscapePlayButtonCornerToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="false"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerTopStartButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/corner_top_start"
                        android:textSize="11sp"
                        android:textColor="@color/toggle_button_selected_text_color"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        app:backgroundTint="@color/toggle_button_selected_background_tint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerTopEndButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/corner_top_end"
                        android:textSize="11sp"
                        android:textColor="@color/toggle_button_selected_text_color"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        app:backgroundTint="@color/toggle_button_selected_background_tint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerBottomStartButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/corner_bottom_start"
                        android:textSize="11sp"
                        android:textColor="@color/toggle_button_selected_text_color"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        app:backgroundTint="@color/toggle_button_selected_background_tint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerBottomEndButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/corner_bottom_end"
                        android:textSize="11sp"
                        android:textColor="@color/toggle_button_selected_text_color"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        app:backgroundTint="@color/toggle_button_selected_background_tint" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Landscape Scrub Sensitivity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scrub_sensitivity_label"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scrub_sensitivity_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/scrubSensitivityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="8dp"
                    tools:text="100 px / word" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/scrubSensitivitySlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="10"
                    android:valueTo="300"
                    android:value="100"
                    android:stepSize="10" />

                <!-- Color Preset Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_color_settings"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/colorPresetDropdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/colorPresetDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/select_color_theme"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Timing Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timing_settings"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timing_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="16dp" />

                <!-- Master Punctuation Pausing Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/punctuationPausingToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/punctuation_pausing_label"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/punctuation_pausing_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Comma Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/commaPauseSetting" />

                <!-- Period Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/periodPauseSetting" />

                <!-- Semicolon Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/semicolonPauseSetting" />

                <!-- Colon Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/colonPauseSetting" />

                <!-- Question Mark Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/questionPauseSetting" />

                <!-- Exclamation Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/exclamationPauseSetting" />

                <!-- Line Break Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/lineBreakPauseSetting" />

                <!-- Paragraph Break Pause -->
                <include layout="@layout/timing_setting_item"
                    android:id="@+id/paragraphPauseSetting" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Word Length Timing Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_length_timing_title"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/word_length_timing_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/wordLengthTimingToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/word_length_timing_toggle_label"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/wordLengthTimingControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Baseline Word Length -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/word_length_baseline_label"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/word_length_baseline_description"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wordLengthBaselineValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/wordLengthBaselineSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="2"
                        android:valueTo="10"
                        android:stepSize="1"
                        android:value="5"
                        android:layout_marginBottom="16dp" />

                    <!-- Scaling Factor -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/word_length_scaling_label"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/word_length_scaling_description"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wordLengthScalingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/wordLengthScalingSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="25"
                        android:stepSize="1"
                        android:value="8" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Theme Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_settings"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="12dp" />

                <!-- Theme Mode Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_mode_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/themeModeToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLightTheme"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/light_theme"
                        app:icon="@drawable/ic_light_mode" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDarkTheme"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dark_theme"
                        app:icon="@drawable/ic_dark_mode" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSystemTheme"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/system_theme"
                        app:icon="@drawable/ic_auto_mode" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Theme Style Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_style_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/themeStyleToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMaterialDefault"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/material_default"
                        app:icon="@drawable/ic_palette" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMaterialDynamic"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/material_dynamic"
                        app:icon="@drawable/ic_auto_awesome" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Page View Appearance Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_view_appearance_settings"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="12dp" />

                <!-- Page View Font Size -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_view_font_size_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/pageViewFontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18sp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/pageViewFontSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="10"
                    android:valueTo="48"
                    android:value="18"
                    android:stepSize="1" />

                <!-- Page View Color Preset Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/pageViewColorPresetDropdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/pageViewColorPresetDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/page_view_color_theme_label"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Page View Scroll Mode -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_view_scroll_mode_label"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/pageViewScrollModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pageViewScrollModeContinuous"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/page_view_scroll_mode_continuous"
                        android:textColor="@color/toggle_button_selected_text_color"
                        app:backgroundTint="@color/toggle_button_selected_background_tint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pageViewScrollModePaged"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/page_view_scroll_mode_paged"
                        android:textColor="@color/toggle_button_selected_text_color"
                        app:backgroundTint="@color/toggle_button_selected_background_tint" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Paragraph Spacing Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/paragraphSpacingToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/paragraph_spacing_label"
                    android:checked="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paragraph_spacing_description"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Listening (TTS) Settings -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ttsSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tts_section_title"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="12dp" />

                <!-- TTS Backend Picker -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ttsBackendDropdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/tts_backend_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ttsBackendDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Language filter (System backend only) — narrows the voice dropdown so the
                     user doesn't scroll through 100+ regional voices. Visibility toggled in
                     OptionsFragment.renderTtsCard based on the active backend. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ttsLanguageDropdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/tts_language_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ttsLanguageDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Voice Picker -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ttsVoiceDropdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/tts_voice_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ttsVoiceDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Neural model folder helper (visible only when Neural backend selected) -->
                <LinearLayout
                    android:id="@+id/ttsNeuralFolderSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tts_neural_folder_label"
                        android:textAppearance="?attr/textAppearanceBody2" />

                    <TextView
                        android:id="@+id/ttsNeuralFolderPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textIsSelectable="true"
                        android:fontFamily="monospace"
                        tools:text="/storage/emulated/0/Android/data/com.speedread.rsvp/files/tts_models" />

                    <TextView
                        android:id="@+id/ttsNeuralEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/tts_neural_empty_state"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ttsBrowseCatalogButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/tts_browse_catalog" />

                </LinearLayout>

                <!-- Speech rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tts_rate_label"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/ttsRateSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="3.0"
                    android:stepSize="0.1"
                    android:value="1.0" />

                <!-- Pitch -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tts_pitch_label"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/ttsPitchSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    android:stepSize="0.1"
                    android:value="1.0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Advanced Settings -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_settings"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:layout_marginBottom="12dp" />

                <!-- Reset to Defaults -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetDefaults"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_to_defaults"
                    app:icon="@drawable/ic_restore" />


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
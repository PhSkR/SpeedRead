<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SpeedRead" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- DO NOT set status bar here - will be overridden programmatically -->
    </style>
    
    <!-- Dynamic Material 3 theme for Android 12+ -->
    <style name="Theme.SpeedRead.Dynamic" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- DO NOT set status bar here - will be overridden programmatically -->
    </style>
    
    <!-- Custom button style for light mode -->
    <style name="Widget.SpeedRead.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
    
    <!-- Custom slider style for light mode -->
    <style name="Widget.SpeedRead.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorOutline</item>
    </style>
    
    <!-- Custom switch style for light mode -->
    <style name="Widget.SpeedRead.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_light</item>
        <item name="trackTint">@color/switch_track_light</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>